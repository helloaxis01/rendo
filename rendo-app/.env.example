# Copy to .env.local (and Netlify site env)

GEMINI_API_KEY=
# Optional override, e.g. gemini-2.5-flash
GEMINI_MODEL=

# Supabase — required for Google/Apple sign-in + cloud backup
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# In Supabase Dashboard:
# 1. Authentication → Providers → enable Google (and Apple if used)
# 2. Add redirect URL: https://YOUR_DOMAIN/auth/callback
#    (also http://localhost:3000/auth/callback for local)
# 3. Run supabase/migrations/001_rendo_core.sql
